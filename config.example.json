{
  "steam_roots": [],
  "steamcmd_path": "tools/steamcmd/steamcmd.exe",
  "log_dir": "logs",
  "timeout_minutes": 180,
  "licence_timeout_seconds": 90,
  "auto_update": {
    "enabled": true,
    "validate": false,
    "skip_if_steam_running": true,
    "exclude_appids": []
  },
  "jobs": [],
  "licence_cache": {
    "denied_days": 7,
    "granted_hours": 0,
    "cooldown_minutes": 60
  },
  "licence_fallback": {
    "enabled": true,
    "max_checks_per_run": 8,
    "retry_unknown_hours": 48
  }
}
